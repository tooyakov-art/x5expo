{
  "expo": {
    "name": "X5 Marketing",
    "slug": "x5-marketing-expo",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "x5marketing",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.x5marketing.mobile",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "X5 Marketing uses your camera to take photos for creating AI-enhanced marketing materials, including advertisements, product photos, and social media content.",
        "NSPhotoLibraryUsageDescription": "X5 Marketing accesses your photo library to select images for creating AI-enhanced marketing materials, such as advertisements, logos, and social media posts.",
        "NSMicrophoneUsageDescription": "X5 Marketing uses your microphone to record audio for creating video marketing content."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.x5marketing.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#A855F7"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b18e607a-c085-413f-aad9-da2da59d2381"
      }
    },
    "owner": "ke1nmann21",
    "updates": {
      "url": "https://u.expo.dev/b18e607a-c085-413f-aad9-da2da59d2381"
    }
  }
}
